APP_ENV=development
APP_NAME=Contratos GBI
APP_URL=http://localhost:8000
SECRET_KEY=change-me-with-at-least-32-random-characters
DATABASE_URL=sqlite:///./contracts.db
ACCESS_TOKEN_MINUTES=720

# ERP: used only by contracts_sync
ERP_DB_SERVER=127.0.0.1
ERP_DB_PORT=11433
ERP_DB_NAME=smb001
ERP_DB_USER=sa
ERP_DB_PASSWORD=
ERP_SYNC_START_DATE=2022-04-29
ERP_FREIGHT_SYNC_START_DATE=2025-08-01
ERP_SYNC_INTERVAL_MINUTES=60

RESEND_API_KEY=
RESEND_FROM_EMAIL=nao-responda@atendimento-gbi.online
REPORT_DAY=5
REPORT_TIME=07:00
MONTHLY_REPORTS_ENABLED=false
TIMEZONE=America/Sao_Paulo

# Optional rclone destination, for example: s3:bucket/contracts-gbi
BACKUP_REMOTE=
BACKUP_REMOTE_REQUIRED=false

# Optional one-time bootstrap. Password is generated when omitted.
BOOTSTRAP_ADMIN_EMAIL=admin@gbi.com
BOOTSTRAP_ADMIN_NAME=Administrador GBI
BOOTSTRAP_ADMIN_PASSWORD=
